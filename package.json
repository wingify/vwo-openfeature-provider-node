{
  "name": "vwo-openfeature-provider-node",
  "version": "1.0.0",
  "description": "Openfeature Provider for VWO Node SDK",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "tsc --build --clean",
    "build": "tsc --build",
    "build:uglify": "tsc --build && yarn run uglify",
    "lint": "eslint . --ext .ts",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier -w src/**/*.ts *.md",
    "uglify": "uglifyjs ./dist/index.js --compress --mangle --source-map --output ./dist/index.min.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wingify/vwo-openfeature-provider-node.git"
  },
  "author": "VWO",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wingify/vwo-openfeature-provider-node/issues"
  },
  "homepage": "https://github.com/wingify/vwo-openfeature-provider-node#readme",
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.23.0",
    "wingify-fme-node-sdk": "^1.80.0"
  },
  "devDependencies": {
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "typescript": "^5.4.5",
    "uglify-js": "^3.19.3",
    "wingify-fme-node-sdk": "^1.80.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "globOptions": {
      "matchBase": false
    },
    "linters": {
      "**/*.js": [
        "yarn lint",
        "prettier",
        "git add"
      ],
      "**/*.{json,md}": [
        "prettier",
        "git add"
      ]
    }
  },
  "keywords": [
    "Openfeature",
    "Openfeature Provider",
    "VWO",
    "Node",
    "SDK"
  ]
}
