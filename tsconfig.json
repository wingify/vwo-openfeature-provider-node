{
  "compilerOptions": {
    "noEmit": false,
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "dist",
    "noImplicitAny": false,
    "noImplicitThis": false,
    "module": "nodenext",
    "target": "es2022",
    "removeComments": false,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*"],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "*.js"
  ]
}
